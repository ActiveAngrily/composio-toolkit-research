# Copy to .env and fill in. .env is gitignored.
#
# Required: search, fetch and the toolkit registry all run through Composio.
#   platform.composio.dev -> Settings -> API Keys
COMPOSIO_API_KEY=ak_xxxxxxxxxxxxxxxxxxxx

# Only needed for --backend sdk, i.e. running the extraction step outside
# Composio's workbench. Inside the workbench the LLM is provided.
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4.1
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-sonnet-4-5
